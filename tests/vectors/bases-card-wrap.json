    false
   ],
   "expected": null
  },
  {
   "name": "7 rename of a base moves its keys",
   "fn": "renameKeys",
   "args": [
    {
     "A/Q.base\u0000V1": 1,
     "A/Q.base\u0000V2": 2,
     "B.base\u0000V1": 3
    },
    "A/Q.base",
    "A/Quotes.base"
   ],
   "expected": {
    "B.base\u0000V1": 3,
    "A/Quotes.base\u0000V1": 1,
    "A/Quotes.base\u0000V2": 2
   }
  },
  {
   "name": "7 rename of a folder moves the keys of each base in it",
   "fn": "renameKeys",
   "args": [
    {
     "A/Q.base\u0000V1": 1,
     "A/sub/R.base\u0000V1": 2,
     "AB/Q.base\u0000V1": 3
    },
    "A",
    "Z"
   ],
   "expected": {
    "AB/Q.base\u0000V1": 3,
    "Z/Q.base\u0000V1": 1,
    "Z/sub/R.base\u0000V1": 2
   }
  },
  {
   "name": "7 rename of an unrelated file changes nothing",
   "fn": "renameKeys",
   "args": [
    {
     "A/Q.base\u0000V1": 1
    },
    "A/Q.md",
    "A/R.md"
   ],
   "expected": {
    "A/Q.base\u0000V1": 1
   }
  },
  {
   "name": "7 rename onto a name with a rule replaces that rule",
   "fn": "renameKeys",
   "args": [
    {
     "Q.base\u0000V1": 1,
     "R.base\u0000V1": 2
    },
    "Q.base",
    "R.base"
   ],
   "expected": {
    "R.base\u0000V1": 1
   }
  },
  {
   "name": "7 rename of a view moves its rule",
   "fn": "renameView",
   "args": [
    {
     "Q.base\u0000Old": 1,
     "Q.base\u0000Other": 2
    },
    "Q.base",
    "Old",
    "New"
   ],
   "expected": {
    "Q.base\u0000Other": 2,
    "Q.base\u0000New": 1
   }
  },
  {
   "name": "4 embed with a view name gives the view",
   "fn": "embedViewName",
   "args": [
    "Quotes.base#Quotes"
   ],
   "expected": "Quotes"
  },
  {
   "name": "4 embed without a view name gives null",
   "fn": "embedViewName",
   "args": [
