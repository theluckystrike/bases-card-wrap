      "mode": "clamp",
      "lines": 2
     }
    },
    "Q.base",
    "Quotes",
    true
   ],
   "expected": {
    "props": {},
    "all": {
     "mode": "clamp",
     "lines": 2
    }
   }
  },
  {
   "name": "9 code block without a path uses only the Pro default",
   "fn": "effectiveRule",
