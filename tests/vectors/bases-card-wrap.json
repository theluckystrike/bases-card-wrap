   ],
   "expected": null
  },
  {
   "name": "4 embed link path drops the view name",
   "fn": "embedLinkPath",
   "args": [
    "Bases/Quotes.base#My view"
   ],
   "expected": "Bases/Quotes.base"
  },
  {
   "name": "9 empty rule is empty",
   "fn": "isEmptyRule",
   "args": [
    {
