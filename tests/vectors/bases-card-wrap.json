     "props": {
      "note.a": {
       "mode": "wrap",
       "lines": 2
      }
     },
     "all": {
      "mode": "core",
      "lines": 3
     }
    }
   ],
   "expected": false
  },
  {
   "name": "9 describe lists all properties and the exceptions",
   "fn": "describeRule",
   "args": [
    {
     "props": {
      "note.quote": {
       "mode": "clamp",
       "lines": 4
      },
      "file.name": {
       "mode": "clamp",
       "lines": 1
      }
     },
     "all": {
      "mode": "wrap",
      "lines": 3
     }
    }
   ],
   "expected": "All properties: 3 lines, scroll, file.name: 1 line, note.quote: 4 lines"
  }
 ]
}
